# ──────────────────────────────────────────────────────────────
# Railway Block Planner — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to version control.
# ──────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_NAME="Railway Block Planner"
APP_VERSION="0.1.0"
DEBUG=true

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_USER=railway
POSTGRES_PASSWORD=railway_secret
POSTGRES_DB=railway_block_planner
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://railway:railway_secret@db:5432/railway_block_planner

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ─────────────────────────────────────────────────────
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
